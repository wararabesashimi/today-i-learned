{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Today-I-Learned","text":"<p>TIL\u65b9\u5f0f\u306e\u5b66\u7fd2\u8a18\u9332\u30ea\u30dd\u30b8\u30c8\u30ea</p> <ul> <li>\u6708\u520a\u5b66\u7fd2\uff1a\u6708\u9593\u3067\u305d\u306e\u65e5\u5b66\u7fd2\u3057\u305f\u3053\u3068\u3092\u8a18\u9332\u3059\u308b</li> <li>\u30b8\u30e3\u30f3\u30eb\u5225\u307e\u3068\u3081\uff1a\u4e0d\u5b9a\u671f\u306b\u30b8\u30e3\u30f3\u30eb\u3054\u3068\u306e\u5b66\u7fd2\u306e\u307e\u3068\u3081\u3092\u8a18\u9332\u3059\u308b</li> </ul>"},{"location":"#_1","title":"\u5b66\u7fd2\u30b8\u30e3\u30f3\u30eb","text":""},{"location":"#amazon-web-service","title":"Amazon Web Service","text":"<pre><code>- Certified Developer Associate\n- Certified Solutions Architect Associate\n</code></pre>"},{"location":"#git","title":"Git","text":"<pre><code>- Github\n- Github Actions\n- Github Pages\n</code></pre>"},{"location":"#_2","title":"\u30cd\u30c3\u30c8\u30ef\u30fc\u30af","text":"<pre><code>- VPN\n- IP\u30a2\u30c9\u30ec\u30b9\n- LAN/WAN\n- DNS\n- BGP\n</code></pre>"},{"location":"#_3","title":"\u305d\u306e\u4ed6","text":"<p>Start -&gt; 2026.09.11</p>"},{"location":"2026-09/","title":"2026-09","text":""},{"location":"2026-09/#2026-09_1","title":"2026-09 \u76ee\u6a19","text":"<ul> <li>MkDcos, Github Actions\u3092\u4f7f\u3063\u305fTIL\u30b5\u30a4\u30c8\u306e\u74b0\u5883\u69cb\u7bc9</li> <li>[AWS\u8a8d\u5b9aSAA] <code>2-1 \u30ea\u30fc\u30b8\u30e7\u30f3\u3068\u30a2\u30d9\u30a4\u30e9\u30d3\u30ea\u30c6\u30a3\u30be\u30fc\u30f3</code> \u304b\u3089 <code>4-2 EC2</code> \u307e\u3067\u306e\u7406\u89e3</li> </ul>"},{"location":"2026-09/#09-22","title":"09-22","text":"<p><code>MkDocs</code>\u3068<code>Github Actions</code>, <code>Github Pages</code>\u306b\u3088\u308bTIL\u8a18\u9332\u30b5\u30a4\u30c8\u306e\u74b0\u5883\u69cb\u7bc9\u304c\u5b8c\u4e86</p> <ul> <li>\u5b66\u7fd2\u958b\u59cb\u306f2026-09-11  </li> </ul> <p>\u30ea\u30fc\u30b8\u30e7\u30f3\u306fAWS\u304c\u30b5\u30fc\u30d3\u30b9\u3092\u63d0\u4f9b\u3057\u3066\u3044\u308b\u56fd\u3084\u62e0\u70b9\u3092\u6307\u3059\u3002 \u30ea\u30fc\u30b8\u30e7\u30f3\u540c\u58eb\u306f\u5730\u7406\u7684\u306b\u96e2\u308c\u305f\u4f4d\u7f6e\u306b\u5b58\u5728\u3059\u308b\u3002</p> <p>\u30a2\u30d9\u30a4\u30e9\u30d3\u30ea\u30c6\u30a3\u30be\u30fc\u30f3(AZ)\u306f\u8907\u6570\u306e\u30c7\u30fc\u30bf\u30bb\u30f3\u30bf\u30fc(DC)\u304b\u3089\u69cb\u6210\u3055\u308c\u3001\u30ea\u30fc\u30b8\u30e7\u30f3\u306f\u8907\u6570\u306eAZ\u304b\u3089\u69cb\u6210\u3055\u308c\u308b\u3002</p> <p>\u30ea\u30fc\u30b8\u30e7\u30f3 &gt; AZ &gt; DC</p> <p>\u5404AZ\u540c\u58eb\u306f\u5730\u7406\u7684\u3001\u96fb\u6e90\u7684\u306b\u72ec\u7acb\u3057\u305f\u5834\u6240\u306b\u3042\u308a\u3001\u6700\u4f4e\u3067\u3082\u6570\u5341km\u306f\u96e2\u308c\u3066\u3044\u308b\u3089\u3057\u3044\u3002 \u4eee\u306b\u707d\u5bb3\u7b49\u3067AZ\u306e\u4e00\u3064\u304c\u4f7f\u7528\u4e0d\u53ef\u306b\u306a\u3063\u305f\u3068\u3057\u3066\u3082\u3001\u30ea\u30fc\u30b8\u30e7\u30f3\u5185\u306e\u4ed6\u306eAZ\u3067\u30b5\u30fc\u30d3\u30b9\u3092\u7d99\u7d9a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3002 \u2192 \u9ad8\u8010\u4e45\u6027\u3001\u9ad8\u4fe1\u983c\u6027\u306e\u62c5\u4fdd</p> <p>\u305f\u3060\u3057\u5f53\u7136\u306a\u304c\u3089\u30e6\u30fc\u30b6\u30fc\u5074\u304c\u5358\u4e00\u306eAZ\u306b\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9\u3092\u7acb\u3066\u3066\u3044\u305f\u5834\u5408\u306f\u30aa\u30f3\u30d7\u30ec\u3068\u306a\u3093\u3089\u5909\u308f\u308a\u306a\u3044\u3002 \u2192 \u5197\u9577\u7684\u306a <code>\u30de\u30eb\u30c1AZ</code> \u3067\u9ad8\u8010\u4e45\u6027\u3092\u78ba\u4fdd\u3059\u308b\u3002</p> <p>AZ 1\u306b\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9 1\u3001AZ 2\u306b\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9 2\u3092\u7acb\u3066\u3066\u3001DB\u3092\u30e1\u30a4\u30f3\u304b\u3089\u30b5\u30d6\u3078\u30ec\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3059\u308b\u7b49\u3059\u308b\u3068\u3001\u7570\u306a\u308b\u30b5\u30fc\u30d0\u30fc\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3082\u540c\u3058DB\u306e\u30c7\u30fc\u30bf\u3092\u8fd4\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u3002</p>"},{"location":"2026-09/#09-23","title":"09-23","text":"<p><code>git remote add &lt;\u30ea\u30e2\u30fc\u30c8\u540d&gt; &lt;\u30ea\u30e2\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u30ea\u30f3\u30af&gt;</code> \u3067origin\u4ee5\u5916\u306e\u30ea\u30e2\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea\u3092\u4fdd\u6301\u3057\u3066\u304a\u304f\u3053\u3068\u304c\u3067\u304d\u308b\u3002 \u2192 \u30ea\u30f3\u30af\u306b\u306f <code>https</code> \u304b <code>SSH</code> \u306e\u3082\u306e\u3092\u8cbc\u308a\u4ed8\u3051\u308b\u3002</p> <p>2026/09/25 \u8ffd\u8a18</p> <p><code>git clone</code> \u7b49\u3057\u305f\u30ed\u30fc\u30ab\u30eb\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u4e2d\u306b\u751f\u6210\u3055\u308c\u308b .git \u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3088\u308a\u3001\u30ea\u30dd\u30b8\u30c8\u30ea\u3054\u3068\u306e\u60c5\u5831\u304c\u4fdd\u6301\u3055\u308c\u3066\u3044\u308b\u305f\u3081\u3001<code>git branch</code> \u3084 <code>git remote</code> \u3068\u3044\u3063\u305f\u30b3\u30de\u30f3\u30c9\u306f\u30ed\u30fc\u30ab\u30eb\u30ea\u30dd\u30b8\u30c8\u30ea\u914d\u4e0b\u3067\u3057\u304b\u5b9f\u884c\u3067\u304d\u306a\u3044\u3002 \u3055\u3089\u306b\u3001\u4e00\u3064\u306e\u30ed\u30fc\u30ab\u30eb\u30ea\u30dd\u30b8\u30c8\u30ea\u304b\u3089\u8907\u6570\u306e\u30ea\u30e2\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea\u306bpush\u3059\u308b\u308f\u3051\u3067\u306f\u306a\u3044\u306a\u3089\u3001<code>git remote add</code> \u3067\u8907\u6570\u306e\u30ea\u30e2\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea\u3092\u4fdd\u6301\u3057\u3066\u304a\u304f\u7406\u7531\u306f\u7279\u306b\u306a\u3055\u305d\u3046\u3002 \u8907\u6570\u306e\u30ea\u30e2\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea\u3092origin\u3068\u3057\u3066\u8a2d\u5b9a\u3059\u308b\u306a\u3089\u3001 <code>git remote set-url --add &lt;\u30ea\u30e2\u30fc\u30c8\u540d&gt; &lt;2\u3064\u76ee\u306e\u30ea\u30e2\u30fc\u30c8\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u30ea\u30f3\u30af&gt;</code> \u3068\u3059\u308c\u3070\u3001<code>git push</code> \u3068\u3059\u308b\u3060\u3051\u3067&lt;\u30ea\u30e2\u30fc\u30c8\u540d&gt;\u306bset\u3055\u308c\u305f\u5168\u3066\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u30d6\u30e9\u30f3\u30c1\u306bpush\u3055\u308c\u308b\u3002</p> <p>\u500b\u5225\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u306bpush\u3059\u308b\u6642\u306b\u306f\u3001<code>git remote add</code> \u3067\u8ffd\u52a0\u3057\u305f\u30ea\u30e2\u30fc\u30c8\u540d\u3092\u6307\u5b9a\u3059\u308b\u3002</p> <pre><code>git push &lt;\u30ea\u30e2\u30fc\u30c8\u540d&gt; &lt;\u30d6\u30e9\u30f3\u30c1\u540d&gt;\n</code></pre> <p>\u4f59\u8ac7\u3060\u304c\u3001<code>git push</code> \u306e\u3088\u3046\u306b\u5f15\u6570\u3092\u7701\u7565\u3057\u305f\u5834\u5408\u306f\u3001</p> <pre><code>git config --global push.default\n</code></pre> <p>\u3067\u6307\u5b9a\u3057\u305f\u8a2d\u5b9a\u3067push\u3092\u884c\u3046\u3002 push.default\u306e\u8a2d\u5b9a\u3092\u5909\u66f4\u3057\u305f\u3044\u5834\u5408\u306f\u4ee5\u4e0b\u306e\u30b3\u30de\u30f3\u30c9\u3067\u8a2d\u5b9a\u3002</p> <pre><code>git config --global push.default simple\n</code></pre>"},{"location":"2026-09/#09-24","title":"09-24","text":"<p><code>Virtual Private Cloud(VPC)</code> \u3068\u306f\u3001AWS\u306e\u4e2d\u6838\u7684\u30b5\u30fc\u30d3\u30b9\u3002 AWS\u306e\u307b\u3068\u3093\u3069\u306e\u30b5\u30fc\u30d3\u30b9\u3092\u5229\u7528\u3059\u308b\u305f\u3081\u306b\u306f\u524d\u63d0\u3068\u3057\u3066\u5fc5\u8981\u3002</p> <p>\u4e00\u3064\u306eAWS\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u8907\u6570\u306eVPC\u3092\u7acb\u3066\u308b\u3053\u3068\u3082\u53ef\u80fd\u3060\u304c\u3001\u6700\u8fd1\u306e\u69cb\u6210\u306f1\u30a2\u30ab\u30a6\u30f3\u30c8\u306b1VPC\u3068\u3057\u3066\u691c\u8a3c\u74b0\u5883\u3084\u958b\u767a\u74b0\u5883\u3001\u672c\u756a\u74b0\u5883\u3067\u5225\u3005\u306e\u30a2\u30ab\u30a6\u30f3\u30c8(VPC)\u3092\u7528\u610f\u3059\u308b\u3053\u3068\u3067\u3001\u4ed6\u74b0\u5883\u3078\u306e\u5f71\u97ff\u3092\u306a\u304f\u3059\u624b\u6cd5\u304c\u53d6\u3089\u308c\u308b\u3053\u3068\u304c\u591a\u3044\u3002</p> <p>VPC\u306e\u4e2d\u306b\u306f\u30b5\u30d6\u30cd\u30c3\u30c8\u3001\u305d\u3057\u3066EC2\u3084ECS\u7b49\u304c\u7f6e\u304b\u308c\u308b\u304c\u3001\u4e00\u6614\u524d\u306f\u5358\u4e00VPC\u306b\u74b0\u5883\u5225\u306e\u8907\u6570\u306e\u30b5\u30d6\u30cd\u30c3\u30c8(EC2, ECS)\u3092\u7f6e\u3044\u3066\u3001\u7ba1\u7406\u3059\u308b\u3053\u3068\u3082\u591a\u304b\u3063\u305f\u3089\u3057\u3044\u3002 \u2192 \u5358\u4e00VPC\u3060\u3068VPC\u81ea\u4f53\u306b\u969c\u5bb3\u304c\u8d77\u304d\u305f\u5834\u5408\u3001\u5168\u3066\u306e\u74b0\u5883\u306b\u5f71\u97ff\u304c\u51fa\u3066\u3057\u307e\u3046\u53ef\u80fd\u6027\u304c\u3042\u308b\u305f\u3081\u3001\u73fe\u5728\u3067\u306f\u671b\u307e\u3057\u304f\u306a\u3044\u3002</p> <p><code>CloudTrail</code> \u306e\u30ed\u30b0\u3082\u30a2\u30ab\u30a6\u30f3\u30c8\u3054\u3068\u306e\u305f\u3081\u3001\u74b0\u5883\u5225\u306e\u30ed\u30b0\u304c\u5224\u5225\u3057\u3065\u3089\u304f\u306a\u308b\u554f\u984c\u3082\u3042\u308b\u3002 \u3055\u3089\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3054\u3068\u306b\u5206\u3051\u308c\u3070\u3001\u74b0\u5883\u5225\u306e\u6599\u91d1\u3082\u4e00\u76ee\u3067\u308f\u304b\u308b\u3002</p> <p>\u2192 1\u30a2\u30ab\u30a6\u30f3\u30c8\u306b1VPC\u304c\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9</p> <p>VPC\u306b\u306f\u3001IPv4\u306eCIDR(\u30aa\u30d7\u30b7\u30e7\u30f3\u3067IPv6\u3082\u53ef)\u3092\u632f\u308a\u5206\u3051\u308b\u5fc5\u8981\u304c\u3042\u308b\u3002</p> <p>\u6307\u5b9a\u3067\u304d\u306a\u3044CIDR\u306b\u306f\u4ee5\u4e0b\u306e4\u7a2e\u985e\u304c\u3042\u308b\u3002</p> <pre><code>0.0.0.0/8\n127.0.0.0/8 (\u5185\u90e8\u30db\u30b9\u30c8\u30eb\u30fc\u30d7\u30d0\u30c3\u30af\u30a2\u30c9\u30ec\u30b9\u7bc4\u56f2)\n169.254.0.0/16 (\u30ea\u30f3\u30af\u30ed\u30fc\u30ab\u30eb\u30a2\u30c9\u30ec\u30b9\u7bc4\u56f2)\n224.0.0.0/4 (\u30de\u30eb\u30c1\u30ad\u30e3\u30b9\u30c8\u30a2\u30c9\u30ec\u30b9\u7bc4\u56f2)\n172.17.0.0/16(Cloud9\u3068SageMaker\u306e\u7bc4\u56f2)\n</code></pre> <p>\u307e\u305f\u3001 <code>RFC1918</code> \u306b\u3088\u3063\u3066\u5b9a\u3081\u3089\u308c\u3066\u3044\u308b\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8IP\u30a2\u30c9\u30ec\u30b9\u306e\u5272\u5f53\u306e\u7bc4\u56f2\u5916\u3092VPC\u5185\u306eCIDR\u306b\u6307\u5b9a\u3057\u3066\u3082\u826f\u3044\u304c\u3001\u540c\u3058IP\u30a2\u30c9\u30ec\u30b9\u3067\u5916\u3078\u306e\u901a\u4fe1\u6642\u306b\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u7a7a\u9593\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3057\u307e\u3046\u305f\u3081\u3001\u57fa\u672c\u306f <code>RFC1918</code> \u306e\u7bc4\u56f2\u5185\u3067CIDR\u3092\u5b9a\u3081\u308b\u3002</p> <pre><code>10.0.0.0    -   10.255.255.255 (10.0.0.0/8)\n172.16.0.0  -   172.31.255.255 (172.16.0.0/12)\n192.168.0.0 -   192.168.255.255 (192.168.0.0/16)\n</code></pre>"},{"location":"2026-09/#09-25","title":"09-25","text":"<p>\u5225\u306e\u4f1a\u793e\u3067\u63a1\u7528\u3082\u3084\u3063\u3066\u3044\u308b\u77e5\u4eba\u306b\u300c\u30dd\u30fc\u30c8\u30d5\u30a9\u30ea\u30aa\u306b\u53c2\u8003\u8cc7\u6599\u306eURL\u306a\u3093\u304b\u3092\u8f09\u305b\u3066\u304a\u304f\u3068\u81ea\u5206\u306a\u3089\u8a55\u4fa1\u3059\u308b\u304b\u306a\u300d\u3068\u30a2\u30c9\u30d0\u30a4\u30b9\u3092\u3044\u305f\u3060\u3044\u305f\u306e\u3067\u3001\u30dd\u30fc\u30c8\u30d5\u30a9\u30ea\u30aa\u306eREADME\u306b\u53c2\u8003\u8cc7\u6599\u3092\u7f6e\u304b\u305b\u3066\u3044\u305f\u3060\u3044\u305f\u3002</p> <p>git\u306e\u30b3\u30df\u30c3\u30c8\u30e1\u30c3\u30bb\u30fc\u30b8\u306f\u516c\u5f0f\u304b\u3089\u547d\u4ee4\u5f62(\u65e5\u672c\u8a9e\u3067\u8a00\u3046\u3068\u73fe\u5728\u7cfb)\u3067\u66f8\u304f\u306e\u304c\u826f\u3044\u3068\u3055\u308c\u3066\u3044\u308b\u306e\u3067\u3001\u672c\u65e5\u304b\u3089\u30b3\u30df\u30c3\u30c8\u30e1\u30c3\u30bb\u30fc\u30b8\u306b\u53d6\u308a\u5165\u308c\u3066\u3044\u304f\u3002</p> <p>\u826f\u3044\u4f8b\uff1a\"[feat]#1 xx\u306e\u6a5f\u80fd\u3092\u65b0\u898f\u5b9f\u88c5\u3059\u308b\"</p> <p></p> <p><code>git reset &lt;\u5bfe\u8c61\u30d5\u30a1\u30a4\u30eb\u540d.\u62e1\u5f35\u5b50&gt;</code> \u3067\u30b9\u30c6\u30fc\u30b8\u30f3\u30b0(<code>git add</code> \u3057\u305f\u72b6\u614b)\u3092\u30ea\u30bb\u30c3\u30c8\u3067\u304d\u308b\u3002 \u2192 <code>git reset .</code> \u3068\u3059\u308b\u3053\u3068\u3067\u3001\u5168\u3066\u306e\u30b9\u30c6\u30fc\u30b8\u30f3\u30b0\u3092\u30ea\u30bb\u30c3\u30c8\u3067\u304d\u308b\u3002</p> <p>\u60aa\u9b54\u306e\u30b3\u30de\u30f3\u30c9\u3068\u540d\u9ad8\u3044 <code>rm -rf /</code> \u3060\u304c\u3001<code>rm -rf &lt;\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u540d&gt;/</code> \u306e\u3088\u3046\u306b\u3059\u308c\u3070\u78ba\u8a8d\u3092\u305b\u305a\u306b\u5f37\u5236\u7684\u306b\u6307\u5b9a\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u4ee5\u4e0b\u306e\u5168\u3066\u306e\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3001\u30d5\u30a1\u30a4\u30eb\u3092\u524a\u9664\u3067\u304d\u308b\u3002</p> <p>\u305f\u3060\u3057\u3084\u306f\u308a\u5371\u967a(\u30d2\u30e5\u30fc\u30de\u30f3\u30a8\u30e9\u30fc\u306f\u3064\u304d\u3082\u306e)\u306a\u306e\u3067\u3001<code>alias rm=</code> \u3068\u3057\u3066rm\u30b3\u30de\u30f3\u30c9\u306e\u6319\u52d5\u3092\u4e0a\u66f8\u304d\u3057\u3066\u3057\u307e\u3046\u304b\u3001<code>brew install trash-cli</code> \u3092\u5b9f\u884c\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304b\u3089\u3001 <code>trash</code> \u30b3\u30de\u30f3\u30c9\u3067\u30b4\u30df\u7bb1\u306b\u9001\u3063\u3066\u3057\u307e\u3046\u306e\u304c\u63a8\u5968\u3055\u308c\u3066\u3044\u308b\u3002 \u2192 \u5fa9\u5143\u306f <code>trash-restore</code></p> <p><code>trash-cli</code> \u306f\u6700\u8fd1\u306emacOS\u306b\u306f\u6a19\u6e96\u642d\u8f09\u3089\u3057\u3044\u3002</p> <p></p> <p> \u8ad6\u7406\u524a\u9664\u306b\u3064\u3044\u3066</p> <p>\u8ad6\u7406\u524a\u9664\u3068\u306f\u3001DB\u3067\u306e\u524a\u9664\u30c7\u30fc\u30bf\u306e\u6271\u3044\u3067 <code>delete_flg</code> \u306e\u3088\u3046\u306a\u524a\u9664\u30d5\u30e9\u30b0\u3067\u8868\u306b\u30c7\u30fc\u30bf\u3092\u51fa\u3055\u306a\u3044\u3053\u3068\u3067\u524a\u9664\u3057\u305f\u69d8\u306b\u898b\u305b\u304b\u3051\u308b\u624b\u6cd5\u3002</p> <p>\u524a\u9664\u64cd\u4f5c\u5f8c\u3082DB\u304b\u3089\u30c7\u30fc\u30bf\u3092\u5fa9\u65e7\u3057\u305f\u308a\u3001\u53d6\u5f97\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u305f\u3081\u5b89\u5fc3\u3067\u306f\u3042\u308b\u304c\u3001\u30a2\u30f3\u30c1\u30d1\u30bf\u30fc\u30f3\u3068\u547c\u3070\u308c\u308b\u3053\u3068\u3082\u3042\u308b\u3002</p> \u30e1\u30ea\u30c3\u30c8 \u30c7\u30e1\u30ea\u30c3\u30c8 \u5fc3\u7406\u7684\u306a\u5b89\u5fc3\u611f\u304c\u3042\u308b\u524a\u9664\u30c7\u30fc\u30bf\u3092\u5fa9\u65e7\u3055\u305b\u3089\u308c\u308b\u524a\u9664\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3067\u304d\u308b \u30c7\u30fc\u30bf\u304c\u80a5\u5927\u5316\u3059\u308b\u3053\u3068\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u4f4e\u4e0b\u53d6\u5f97\u6642\u306e\u6761\u4ef6\u306b\u3088\u308b\u30af\u30a8\u30ea\u8907\u96d1\u5316\u30e6\u30cb\u30fc\u30af\u5236\u7d04\u306e\u5de5\u592b\u304c\u5fc5\u8981 <p>\u3053\u308c\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u3084\u306f\u308a\u4e00\u5b9a\u671f\u9593\u3067\u6761\u4ef6\u306b\u5f15\u3063\u639b\u304b\u308b\u30ec\u30b3\u30fc\u30c9\u306f\u30d0\u30c3\u30af\u30a2\u30c3\u30d7(\u5b9a\u671f\u5b9f\u884c\u304b\u524a\u9664\u6642\u306b\u30ed\u30b0\u51fa\u529b\u7b49)\u3092\u53d6\u3063\u305f\u4e0a\u3067\u7269\u7406\u524a\u9664\u3092\u3059\u308b\u7b49\u3067\u5bfe\u7b56\u3059\u308b\u3068\u826f\u3044\u3068\u601d\u308f\u308c\u308b\u3002 \u2192 \u30e6\u30cb\u30fc\u30af\u5236\u7d04\u306b\u95a2\u3057\u3066\u3060\u3051\u8a00\u3048\u3070\u3001\u5225\u9014 <code>deleted_at</code> \u30ab\u30e9\u30e0\u3092\u4f5c\u6210\u3057\u3001<code>email</code> \u7b49\u3068\u306e\u8907\u5408\u30e6\u30cb\u30fc\u30af\u5236\u7d04\u306b\u3059\u308b\u3053\u3068\u3067\u56de\u907f\u3059\u308b\u3068\u3044\u3046\u65b9\u6cd5\u3082\u3042\u308b\u3002</p> <p>\u8ad6\u7406\u524a\u9664\u304c\u7d76\u5bfe\u306b\u60aa\u3068\u3044\u3046\u308f\u3051\u3067\u306f\u306a\u304f\u3001\u30e6\u30fc\u30b9\u30b1\u30fc\u30b9\u306b\u3088\u308b\u3002 \u2192 \u4f8b\u3048\u3070join\u304c\u5c11\u306a\u3044\u3068\u304b\u3001\u30c7\u30fc\u30bf\u80a5\u5927\u5316\u306e\u6050\u308c\u304c\u5c11\u306a\u3044\u3068\u304b\u3001\u30e6\u30cb\u30fc\u30af\u5236\u7d04\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u306a\u3044\u7b49\u306e\u5834\u5408\u306f\u8ad6\u7406\u524a\u9664\u3092\u63a1\u7528\u3057\u3066\u3082\u826f\u3044\u3068\u8a00\u3048\u308b\u3002</p>"}]}